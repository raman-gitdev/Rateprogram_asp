<?xml version="1.0"?>
<!-- Copy to Secrets.config (gitignored) and fill in. The TARIFFHUB_DB environment variable overrides the connection string. -->
<appSettings>
  <add key="TariffHub.ConnectionString" value="Host=192.168.20.26;Port=5432;Database=ratehub;Username=Accrual_Admin;Password=Accrual_admin@123@#" />
  <!-- Comma-separated real client/carrier names found in the data. Any displayed value containing one is shown as [withheld].
       Never put these names in a committed file. -->
  <add key="TariffHub.RedactTerms" value="" />
</appSettings>
